<?xml version="1.0"?>
<!-- Single node HDFS for the demo. No permissions, one copy of each block. -->
<configuration>
  <property>
    <name>dfs.replication</name>
    <value>1</value>
  </property>
  <property>
    <name>dfs.permissions.enabled</name>
    <value>false</value>
  </property>
  <property>
    <name>dfs.namenode.name.dir</name>
    <value>/data/name</value>
  </property>
  <property>
    <name>dfs.datanode.data.dir</name>
    <value>/data/data</value>
  </property>
  <property>
    <name>dfs.namenode.rpc-bind-host</name>
    <value>0.0.0.0</value>
  </property>
</configuration>
